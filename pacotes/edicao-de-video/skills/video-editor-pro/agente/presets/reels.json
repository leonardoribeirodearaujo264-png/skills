{
  "name": "REELS-PRO",
  "descricao": "Vertical, rapido, retencao alta. Reels / Shorts / TikTok.",
  "formato": {"preset": "reels", "resolucao": "1080x1920", "aspect": "9:16", "fps": 30},
  "duracao": {"alvo_s": 45, "maximo_s": 90, "minimo_s": 15},

  "cortes": {
    "intensidade": "alta",
    "remover_silencio_acima_de_s": 0.35,
    "silencio_residual_s": 0.12,
    "padding_antes_s": 0.05,
    "padding_depois_s": 0.08,
    "fade_audio_no_corte_s": 0.03,
    "plano_maximo_sem_evento_s": 3.0,
    "remover": ["falsos_inicios", "repeticoes_involuntarias", "gaguejos",
                "tentativas_erradas", "trechos_sem_valor", "ar_morto"]
  },

  "ritmo": {
    "cortes_por_minuto_alvo": 22,
    "evento_visual_a_cada_s": 3.0,
    "comentario": "Evento visual = corte, zoom, card, B-roll ou destaque. Nao e efeito gratuito: cada um precisa explicar, enfatizar, recuperar atencao, contextualizar, demonstrar ou organizar."
  },

  "legendas": {
    "estilo": "reels",
    "palavras_por_linha": 3,
    "caixa_alta": true,
    "destacar_numeros": true,
    "margem_inferior_de_1080": 420,
    "remover_fillers_do_texto": true
  },

  "zoom": {
    "intensidade": "media",
    "maximo_por_minuto": 4,
    "escala_punch_in": 1.12,
    "duracao_s": 0.35,
    "usar_em": ["frase_chave", "mudanca_de_argumento", "cta", "numero_importante"],
    "nunca": ["cortar_olhos_ou_boca", "zoom_em_toda_frase", "movimento_continuo"]
  },

  "motion": {
    "quantidade": "media",
    "elementos_permitidos": ["titulo", "callout", "numero_animado", "seta", "destaque"],
    "overlay_formato": "webm_alpha",
    "duracao_card_s": [1.5, 4.0]
  },

  "broll": {"quantidade": "media", "cobertura_maxima_pct": 30},

  "audio": {
    "target_lufs": -16,
    "true_peak_dbtp": -1.5,
    "denoise": 0.3,
    "musica": {"usar": false, "ganho_db": -22, "ducking": true}
  },

  "hook": {
    "janela_s": 3.0,
    "exigir_gancho": true,
    "permitir_cold_open": true,
    "comentario": "Cold open so e permitido se a frase movida mantiver o contexto original. Nunca montar frase que a pessoa nao disse."
  },

  "estrutura": ["HOOK", "PROBLEMA", "CURIOSIDADE", "EXPLICACAO", "SOLUCAO", "PROVA", "CTA"],
  "grade": "neutral_punch"
}
