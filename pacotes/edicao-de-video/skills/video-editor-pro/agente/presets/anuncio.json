{
  "name": "ANUNCIO-PRO",
  "descricao": "Conversao. Hook + problema + beneficio + prova + CTA. Sem alegacao falsa.",
  "formato": {
    "preset": "reels",
    "resolucao": "1080x1920",
    "aspect": "9:16",
    "fps": 30
  },
  "duracao": {
    "alvo_s": 30,
    "maximo_s": 60,
    "minimo_s": 15
  },
  "cortes": {
    "intensidade": "alta",
    "remover_silencio_acima_de_s": 0.25,
    "silencio_residual_s": 0.08,
    "padding_antes_s": 0.04,
    "padding_depois_s": 0.06,
    "fade_audio_no_corte_s": 0.03,
    "plano_maximo_sem_evento_s": 2.0,
    "remover": [
      "falsos_inicios",
      "repeticoes_involuntarias",
      "gaguejos",
      "tentativas_erradas",
      "trechos_sem_valor",
      "ar_morto"
    ]
  },
  "ritmo": {
    "cortes_por_minuto_alvo": 30,
    "evento_visual_a_cada_s": 2.0,
    "comentario": "Densidade maxima. Nenhum segundo sem funcao."
  },
  "legendas": {
    "estilo": "anuncio",
    "palavras_por_linha": 2,
    "caixa_alta": true,
    "destacar_numeros": true,
    "margem_inferior_de_1080": 440,
    "remover_fillers_do_texto": true
  },
  "zoom": {
    "intensidade": "alta",
    "maximo_por_minuto": 8,
    "escala_punch_in": 1.15,
    "duracao_s": 0.25,
    "usar_em": [
      "frase_chave",
      "mudanca_de_argumento",
      "cta",
      "numero_importante"
    ],
    "nunca": [
      "cortar_olhos_ou_boca",
      "zoom_em_toda_frase",
      "movimento_continuo"
    ]
  },
  "motion": {
    "quantidade": "alta",
    "elementos_permitidos": [
      "titulo",
      "numero_animado",
      "comparacao",
      "selo",
      "seta",
      "cta_card"
    ],
    "overlay_formato": "webm_alpha",
    "duracao_card_s": [
      1.5,
      4.0
    ]
  },
  "broll": {
    "quantidade": "media",
    "cobertura_maxima_pct": 30
  },
  "audio": {
    "target_lufs": -16,
    "true_peak_dbtp": -1.5,
    "denoise": 0.3,
    "musica": {
      "usar": false,
      "ganho_db": -22,
      "ducking": true
    }
  },
  "hook": {
    "janela_s": 2.0,
    "exigir_gancho": true,
    "permitir_cold_open": true,
